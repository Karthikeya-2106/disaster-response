# Copy to .env and adjust. Every value here has a working default in
# docker-compose.yml, so `docker compose up --build` works with no .env at all.

# --- Ports on your host machine ---
FRONTEND_PORT=3000
BACKEND_PORT=8081
POSTGRES_PORT=5432

# --- Database ---
POSTGRES_DB=disaster_db
POSTGRES_USER=disaster
POSTGRES_PASSWORD=disaster123

# --- Security ---
# The default below is a DEMO secret committed to this repo. Generate your own
# for anything real:  openssl rand -base64 64
JWT_SECRET=mySuperSecretKeyForJWTSigningPleaseChangeMe123456

# --- Optional: free AI (vision triage, duplicate detection, dispatch, chat) ---
# Leave everything below empty and the app uses built-in heuristics — it always works.
#
# auto   = use Gemini if GEMINI_API_KEY is set, otherwise heuristics
# gemini = Google AI Studio free tier. Rate-limited; Google's pricing page states
#          free-tier content is used to improve its products — that includes citizen photos.
# ollama = local model. Free, no key, no quota, offline, photos never leave the machine.
# none   = heuristics only
AI_PROVIDER=auto

# Free key, no card: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Needs a VISION model for photo assessment:  ollama pull qwen2.5vl:3b  (8 GB RAM)
# or qwen2.5vl:7b for better quality with 16 GB+ RAM
# (text-only models like phi3 work for chat/triage but photos fall back to heuristics)
# This file is read by docker compose, so this is Ollama on the HOST as seen from the
# container. When running the backend with mvn instead, the default localhost:11434 applies.
OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen2.5vl:3b
